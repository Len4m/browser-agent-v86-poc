{
  "$schema": "./profile.schema.json",
  "id": "alpine-base",
  "name": "Alpine Base Lite",
  "description": "Alpine mínimo con certificados, curl y nano.",
  "alpineVersion": "3.23.4",
  "output": "v86/images/profiles/alpine-base-initramfs.gz",
  "kernelOutput": "v86/images/alpine-vmlinuz-lts",
  "recommendedRamMb": 512,
  "packages": [
    "ca-certificates",
    "curl",
    "nano",
    "python3"
  ],
  "allowedTools": [
    "vm.python.exec",
    "vm.sh.exec",
    "vm.fs.list",
    "vm.fs.read",
    "vm.fs.write",
    "vm.cmd.which",
    "web.curl.head",
    "vm.sys.info",
    "vm.console.status",
    "vm.pkg.info",
    "web.curl.fetch_text"
  ],
  "firstBootCommands": [
    "update-ca-certificates >/tmp/update-ca-certificates.log 2>&1 || true"
  ],
  "buildCommands": [
    "rm -rf /rootfs/var/cache/apk/* /rootfs/tmp/* /rootfs/var/tmp/*",
    "rm -rf /rootfs/usr/share/man /rootfs/usr/share/doc"
  ],
  "validationCommands": [
    "curl --version",
    "nano --version || true",
    "python3 --version",
    "df -h",
    "free -m"
  ],
  "bootMessage": "Browser Alpine Base Lite ready.",
  "defaultDisk": "initramfs"
}
