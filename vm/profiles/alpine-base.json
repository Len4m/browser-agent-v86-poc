{
  "$schema": "./profile.schema.json",
  "id": "alpine-base",
  "name": "Alpine Base Lite",
  "description": "Alpine mínimo con certificados, curl y nano.",
  "alpineVersion": "3.23.4",
  "minimumRamMb": 512,
  "minimumVramMb": 8,
  "storage": {
    "layout": "overlay-hda",
    "rootDiskMb": 512,
    "workspaceDiskMb": 512,
    "blockSize": 65536,
    "filesystem": "ext4"
  },
  "packages": [
    "ca-certificates",
    "curl",
    "nano",
    "python3"
  ],
  "allowedTools": [
    "vm_python_exec",
    "vm_sh_exec",
    "vm_fs_list",
    "vm_fs_read",
    "vm_fs_write",
    "vm_cmd_which",
    "web_curl_head",
    "vm_sys_info",
    "vm_console_status",
    "vm_pkg_info",
    "web_curl_fetch_text"
  ],
  "firstBootCommands": [
    "update-ca-certificates >/tmp/update-ca-certificates.log 2>&1 || true"
  ],
  "buildCommands": [
    "rm -rf /rootfs/var/cache/apk/* /rootfs/tmp/* /rootfs/var/tmp/*",
    "rm -rf /rootfs/usr/share/man /rootfs/usr/share/doc"
  ],
  "bootMessage": "Browser Alpine Base Lite ready."
}
