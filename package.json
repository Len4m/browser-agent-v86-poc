{
  "name": "browser-agent-v86-poc",
  "description": "Browser Agent v86 POC",
  "version": "0.9.7-beta.1",
  "author": "Lenam <lenamgenx@protonmail.com> (https://Len4m.github.io)",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Len4m/browser-agent-v86-poc.git"
  },
  "bugs": {
    "url": "https://github.com/Len4m/browser-agent-v86-poc/issues"
  },
  "homepage": "https://github.com/Len4m/browser-agent-v86-poc#readme",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "prepare:local": "npm run setup && npm run build",
    "setup": "node scripts/setup.mjs",
    "build": "node scripts/build.mjs",
    "build:prod": "BA_PUBLIC_SITE_URL=${BA_PUBLIC_SITE_URL:-https://browseragent.icu/} BA_MINIFY=1 node scripts/build.mjs",
    "lint": "eslint .",
    "test": "node scripts/test.mjs",
    "check": "tsc --noEmit && npm run lint && npm test && node scripts/check.mjs",
    "clean": "node scripts/clean.mjs",
    "clean:runtime": "node scripts/clean-runtime.mjs",
    "clean:all": "npm run clean && npm run clean:runtime"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@browser-ai/transformers-js": "^2.2.2",
    "@huggingface/transformers": "^4.2.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^6.0.185",
    "dompurify": "^3.4.5",
    "esbuild": "^0.28.0",
    "streaming-markdown": "^0.2.15",
    "v86": "^0.5.359",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0"
  }
}
